+/*
+ * Copy one row of w pixels to the panel, touching only the part that differs from what the
+ * panel already shows (shadow, in normal cacheable memory): reading is cheap, writing
+ * to the panel memory is the slow part.
+ */
+static uint64_t sweet_fb_bytes_written;
+
+static void
+sweet_fb_row(uint8_t *d, uint8_t *sh, const uint8_t *s, size_t w, bool full)
+{
+	size_t i = 0, j = w;
+	if (!full) {
+		while (i + 2 <= w && memcmp(s + i * 4, sh + i * 4, 8) == 0) {
+			i += 2;
+		}
+		while (i < w && memcmp(s + i * 4, sh + i * 4, 4) == 0) {
+			i++;
+		}
+		if (i == w) {
+			return;
+		}
+		while (j - 2 > i && memcmp(s + (j - 2) * 4, sh + (j - 2) * 4, 8) == 0) {
+			j -= 2;
+		}
+		while (j > i + 1 && memcmp(s + (j - 1) * 4, sh + (j - 1) * 4, 4) == 0) {
+			j--;
+		}
+	}
+	memcpy(d + i * 4, s + i * 4, (j - i) * 4);
+	memcpy(sh + i * 4, s + i * 4, (j - i) * 4);
+	sweet_fb_bytes_written += (uint64_t)(j - i) * 4;
+}
