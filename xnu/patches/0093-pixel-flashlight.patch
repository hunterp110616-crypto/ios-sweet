+/*
+ * Pixel 5 flashlight (patch 0093). Only these writes touch the PMIC, and only the flash-LED peripheral
+ * (SID 5 / 0xd3): torch registers as in Google's leds-qpnp-flash-v2.c, EXT_WRITEL on the apid's own write channel.
+ */
+static bool
+keys_wr(uint16_t addr, uint8_t val)
+{
+	if (!keys_flash_chnl) {
+		return false;
+	}
+	*(volatile uint32_t *)(keys_flash_chnl + 0x10) = val;
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(keys_flash_chnl + 0x00) = (uint32_t)(addr & 0xffu) << 4; /* EXT_WRITEL, one byte */
+	__asm__ volatile("dsb osh" ::: "memory");
+	for (unsigned i = 0; i < 1000; ++i) {
+		uint32_t st = keys_rd(keys_flash_chnl, 0x08);
+		if (st & 1u) {
+			return !(st & 0x0eu);
+		}
+		delay(1);
+	}
+	return false;
+}
+
+static bool
+keys_wr_mask(uint16_t addr, uint8_t mask, uint8_t val)
+{
+	uint8_t cur = 0;
+	if (!keys_read(keys_flash_apid, addr, &cur)) {
+		return false;
+	}
+	return keys_wr(addr, (uint8_t)((cur & ~mask) | (val & mask)));
+}
+
+static void
+torch_set(bool on)
+{
+	bool ok = true;
+	if (on) {
+		int code = (torch_ma * 1000 + 6250) / 12500 - 1; /* 12.5 mA per step */
+		if (code < 0) {
+			code = 0;
+		} else if (code > 23) {
+			code = 23; /* 300 mA = Google's torch maximum */
+		}
+		for (int id = 0; id < 2; ++id) {
+			ok &= keys_wr_mask((uint16_t)(0x49 + id), 0x04, 0x00); /* software strobe */
+			ok &= keys_wr((uint16_t)(0x43 + id), (uint8_t)code);   /* TGR_CURRENT */
+			ok &= keys_wr((uint16_t)(0x40 + id), 0x13);            /* safety timer disabled */
+		}
+		ok &= keys_wr_mask(0x47, 0x7f, 0x00);  /* IRES 12.5 mA */
+		ok &= keys_wr_mask(0x46, 0x80, 0x80);  /* MOD_CTRL: module on */
+		delay(5000);
+		ok &= keys_wr_mask(0x4c, 0x03, 0x03);  /* EN_LED_CTRL: both LEDs */
+	} else {
+		ok &= keys_wr_mask(0x4c, 0x03, 0x00);
+		delay(10000);
+		ok &= keys_wr_mask(0x46, 0x80, 0x00);
+	}
+	torch_on = on && ok;
+	torch_run_ms = 0;
+	printf("SWEET TORCH: %s ma=%d ok=%d\n", on ? "on" : "off", torch_ma, ok);
+}
