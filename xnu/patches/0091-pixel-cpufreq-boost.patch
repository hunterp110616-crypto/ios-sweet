--- a/iokit/Kernel/arm/SweetCPU.cpp
+++ b/iokit/Kernel/arm/SweetCPU.cpp
@@ -121,6 +121,64 @@
 	return true;
 }
 
+/*
+ * Pixel 5 (SM7250 lito) CPU DVFS through the three cpufreq-hw (OSM) blocks from its device tree
+ * (qcom,cpufreq-hw): silver 0x18323000, gold 0x18325800, prime 0x18327800.  Nothing in this
+ * kernel ever wrote PERF_STATE, so the cores stayed at whatever table row the bootloader left
+ * (measured on the phone: silver row 6 ~1.4 GHz, gold and prime row 0 ~0.8 GHz).
+ * Register layout is Linux qcom-cpufreq-hw.c: ENABLE 0x0, FREQ_LUT 0x110 and VOLT_LUT 0x114 in
+ * 32-byte rows, CURRENT_VOTE 0x704, PERF_STATE 0x920.  LUT word: bit30 = source (1: XO * lval),
+ * lval = bits 7:0, XO = 19.2 MHz; a repeated frequency ends the table.  The hardware owns
+ * voltage and limits management, only a table row index is written.
+ * Boot-arg pixelcpufreq: 0 = leave alone, 1 = highest row (default), 2 = log only.
+ */
+extern "C" vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+
+static void
+sweet_cpufreq_boost(void)
+{
+	static const uint64_t osm_pa[3] = {0x18323000ULL, 0x18325800ULL, 0x18327800ULL};
+	static const char *const osm_name[3] = {"silver", "gold", "prime"};
+	int mode = 1;
+	PE_parse_boot_argn("pixelcpufreq", &mode, sizeof(mode));
+	if (mode == 0) {
+		IOLog("SWEET CPUFREQ: disabled (pixelcpufreq=0)\n");
+		return;
+	}
+	for (unsigned d = 0; d < 3; d++) {
+		volatile uint32_t *osm = (volatile uint32_t *)ml_io_map(osm_pa[d], 0x1000);
+		if (osm == NULL) {
+			IOLog("SWEET CPUFREQ: %s unavailable\n", osm_name[d]);
+			continue;
+		}
+		const uint32_t enable = osm[0x000 / 4];
+		const uint32_t state = osm[0x920 / 4];
+		uint32_t prev = 0, bestk = 0, best = 0, rows = 0;
+		for (uint32_t i = 0; i < 40; i++) {
+			const uint32_t data = osm[(0x110 + i * 32) / 4];
+			const uint32_t khz = (data >> 30) ? 19200u * (data & 0xff) : 300000u;
+			if (i > 0 && khz == prev) {
+				break;
+			}
+			prev = khz;
+			rows = i + 1;
+			if (khz > bestk) {
+				bestk = khz;
+				best = i;
+			}
+		}
+		IOLog("SWEET CPUFREQ: %s pa=0x%llx enable=%#x perf_state=%u rows=%u best=%u (%u kHz)\n",
+		    osm_name[d], osm_pa[d], enable, state, rows, best, bestk);
+		if (mode == 1 && enable != 0 && bestk >= 300000u && best != state) {
+			osm[0x920 / 4] = best;
+			__builtin_arm_dsb(DSB_SY);
+			IOSleep(5);
+			IOLog("SWEET CPUFREQ: %s perf_state now %u (vote %#x)\n",
+			    osm_name[d], osm[0x920 / 4], osm[0x704 / 4]);
+		}
+	}
+}
+
 /* Do not wait in a nub's start(): matching can be asynchronous or serialized. */
 void
 SweetCPU::startAll(void *arg __unused, wait_result_t result __unused)
@@ -175,6 +233,7 @@
 	ml_set_max_cpus(topology->max_cpu_id + 1);
 	IOLog("SWEET CPU: %u/%u CPUs initialized, SGI1 verified\n",
 	    topology->num_cpus, topology->num_cpus);
+	sweet_cpufreq_boost();
 	thread_terminate(current_thread());
 }
 
